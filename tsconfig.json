{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
